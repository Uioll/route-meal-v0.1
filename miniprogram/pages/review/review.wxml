<view class="page">
  <view class="restaurant-card" wx:if="{{restaurant}}">
    <view class="restaurant-icon">店</view>

    <view class="restaurant-content">
      <text class="restaurant-label">本次到店</text>
      <text class="restaurant-name">
        {{restaurant.name}}
      </text>
      <text class="restaurant-address">
        {{restaurant.address}}
      </text>
    </view>
  </view>

  <view class="review-card" wx:if="{{restaurant && !savedVisit}}">
    <text class="page-title">
      这顿饭吃得怎么样？
    </text>

    <text class="page-subtitle">
      记录真实感受，下次抽签时更懂你
    </text>

    <view class="form-section">
      <text class="form-label">
        个人评分（1～5分）
      </text>

      <input
        class="form-input"
        type="digit"
        placeholder="例如：4.5"
        value="{{personalRating}}"
        bindinput="onRatingInput"
      />
    </view>

    <view class="form-section">
      <text class="form-label">
        简短评价
      </text>

      <textarea
        class="form-textarea"
        placeholder="例如：味道不错，路线也比较顺"
        maxlength="500"
        value="{{visitComment}}"
        bindinput="onCommentInput"
      ></textarea>

      <text class="character-count">
        {{visitComment.length}} / 500
      </text>
    </view>

    <view class="form-section">
      <text class="form-label">
        以后愿意再来吗？
      </text>

      <view class="return-options">
        <view
          class="return-option {{willingToReturn === true ? 'active' : ''}}"
          data-value="true"
          bindtap="selectReturnChoice"
        >
          愿意再来
        </view>

        <view
          class="return-option {{willingToReturn === false ? 'active' : ''}}"
          data-value="false"
          bindtap="selectReturnChoice"
        >
          不愿意
        </view>
      </view>
    </view>

    <button
      class="save-button"
      bindtap="saveVisit"
      loading="{{isSaving}}"
      disabled="{{isSaving}}"
    >
      {{isSaving ? "正在保存..." : "保存用餐记录"}}
    </button>
  </view>

  <view class="saved-card" wx:if="{{savedVisit}}">
    <view class="success-icon">✓</view>

    <text class="saved-title">
      本次用餐已记录
    </text>

    <text class="saved-line">
      餐厅：{{savedVisit.restaurant_name}}
    </text>

    <text class="saved-line">
      个人评分：{{savedVisit.personal_rating}}
    </text>

    <text
      class="saved-line"
      wx:if="{{savedVisit.comment}}"
    >
      评价：{{savedVisit.comment}}
    </text>

    <text class="saved-line">
      是否愿意再来：
      {{savedVisit.willing_to_return ? "愿意" : "不愿意"}}
    </text>

    <button
      class="history-button"
      bindtap="goToHistory"
    >
      查看吃过的餐厅
    </button>

    <button
      class="home-button"
      bindtap="backToHome"
    >
      返回首页
    </button>
  </view>
</view>
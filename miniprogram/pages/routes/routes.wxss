page {
  height: 100%;
  background: #f5f2ef;
}

.route-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f5f2ef;
}

.route-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.location-panel {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  box-sizing: border-box;
  padding: 22rpx 170rpx 22rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 36rpx rgba(55, 45, 38, 0.16);
}

.location-item {
  display: flex;
  align-items: center;
  min-height: 64rpx;
}

.location-dot {
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  margin-right: 22rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
}

.start-dot {
  background: #22b573;
}

.end-dot {
  background: #ff7043;
}

.location-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.location-label {
  margin-bottom: 4rpx;
  color: #a09892;
  font-size: 22rpx;
}

.location-name {
  overflow: hidden;
  color: #2f2925;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-divider {
  width: 2rpx;
  height: 22rpx;
  margin: 0 0 0 12rpx;
  background: #d8d1cc;
}

.travel-mode-badge {
  position: absolute;
  top: 50%;
  right: 24rpx;
  min-width: 92rpx;
  padding: 14rpx 18rpx;
  transform: translateY(-50%);
  border-radius: 999rpx;
  color: #ff7043;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
  background: #fff0ea;
}

.route-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  min-height: 440rpx;
  padding:
    10rpx
    24rpx
    calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(45, 37, 32, 0.16);
}

.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #d8d2ce;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sheet-title {
  display: block;
  color: #2f2925;
  font-size: 36rpx;
  font-weight: 700;
}

.sheet-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #938b85;
  font-size: 24rpx;
}

.route-count {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  color: #6f655f;
  font-size: 23rpx;
  background: #f3efec;
}

.state-box {
  display: flex;
  box-sizing: border-box;
  min-height: 280rpx;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  flex-direction: column;
  border-radius: 24rpx;
  background: #faf8f6;
}

.loading-circle {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 24rpx;
  border: 7rpx solid #f4d7ca;
  border-top-color: #ff7043;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}

@keyframes loading-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.error-title {
  margin-bottom: 12rpx;
  color: #d34f35;
  font-size: 30rpx;
  font-weight: 700;
}

.state-text {
  color: #847b75;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-button {
  width: 230rpx;
  height: 76rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 76rpx;
  background: #ff7043;
}

.retry-button::after {
  border: none;
}

.route-scroll {
  width: 100%;
  white-space: nowrap;
}

.route-option {
  display: inline-flex;
  box-sizing: border-box;
  width: 420rpx;
  min-height: 156rpx;
  margin-right: 20rpx;
  padding: 18rpx 22rpx;
  flex-shrink: 0;
  flex-direction: column;
  border: 3rpx solid transparent;
  border-radius: 22rpx;
  background: #f6f3f0;
}

.route-option:last-child {
  margin-right: 0;
}

.route-option.selected {
  border-color: #ff7043;
  background: #fff4ef;
  box-shadow: 0 8rpx 22rpx rgba(255, 112, 67, 0.15);
}

.route-option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.route-duration {
  color: #2f2925;
  font-size: 34rpx;
  font-weight: 700;
}

.selected-badge {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 21rpx;
  background: #ff7043;
}

.route-distance {
  display: block;
  margin-top: 12rpx;
  color: #6f655f;
  font-size: 25rpx;
}

.route-summary {
  display: block;
  overflow: hidden;
  margin-top: 12rpx;
  color: #978d86;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-tip {
  display: flex;
  min-height: 32rpx;
  align-items: center;
  margin: 0 4rpx 10rpx;
  color: #8d847e;
  font-size: 22rpx;
}

.tip-line {
  width: 42rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
}

.tip-line + text {
  margin-right: 24rpx;
}

.selected-line {
  background: #ff7043;
}

.normal-line {
  background: #9ca3af;
}

.confirm-route-button {
  width: 100%;
  height: 80rpx;
  margin: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 80rpx;
  background: #ff7043;
  box-shadow: 0 10rpx 24rpx rgba(255, 112, 67, 0.26);
}

.confirm-route-button::after {
  border: none;
}

.normal-line {
  background: #5f6773;
}

/* 紧凑版路线选择面板 */
.route-sheet {
  min-height: 0;
  padding:
    8rpx
    20rpx
    calc(12rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-handle {
  width: 62rpx;
  height: 6rpx;
  margin: 0 auto 8rpx;
}

.sheet-header {
  align-items: center;
  margin-bottom: 10rpx;
}

.sheet-title {
  font-size: 31rpx;
}

.sheet-subtitle {
  display: none;
}

.route-count {
  margin-top: 0;
  padding: 6rpx 14rpx;
  font-size: 21rpx;
}

.route-options {
  padding: 0 2rpx 10rpx;
}

.route-option {
  width: 330rpx;
  min-height: 120rpx;
  margin-right: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
}

.route-duration {
  font-size: 29rpx;
}

.selected-badge {
  padding: 5rpx 10rpx;
  font-size: 18rpx;
}

.route-distance {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.route-summary {
  margin-top: 6rpx;
  font-size: 20rpx;
}

/* 已选择标签已经足够表达状态，隐藏图例节省高度 */
.route-tip {
  display: none;
}

.confirm-route-button {
  height: 72rpx;
  font-size: 27rpx;
  line-height: 72rpx;
}
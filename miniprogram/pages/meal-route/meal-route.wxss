page {
  height: 100%;
  background: #f5f2ef;
}

.page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.route-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.restaurant-panel {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  left: 24rpx;
  z-index: 20;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  padding: 22rpx 130rpx 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 36rpx rgba(55, 45, 38, 0.16);
}

.restaurant-dot {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: #ffb13b;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
}

.restaurant-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.panel-label {
  color: #a09892;
  font-size: 21rpx;
}

.restaurant-name {
  overflow: hidden;
  margin-top: 4rpx;
  color: #2f2925;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.restaurant-address {
  overflow: hidden;
  margin-top: 5rpx;
  color: #8c817a;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-badge {
  position: absolute;
  top: 50%;
  right: 22rpx;
  padding: 12rpx 17rpx;
  transform: translateY(-50%);
  border-radius: 999rpx;
  color: #ff7043;
  font-size: 23rpx;
  font-weight: 600;
  background: #fff0ea;
}

.route-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  padding:
    10rpx
    24rpx
    calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(45, 37, 32, 0.16);
}

.sheet-handle {
  width: 64rpx;
  height: 6rpx;
  margin: 0 auto 12rpx;
  border-radius: 999rpx;
  background: #d8d2ce;
}

.sheet-title {
  display: block;
  color: #2f2925;
  font-size: 32rpx;
  font-weight: 700;
}

.route-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eee8e3;
  border-bottom: 1rpx solid #eee8e3;
}

.stat-item {
  display: flex;
  width: 33.33%;
  align-items: center;
  flex-direction: column;
}

.stat-value {
  color: #2f2925;
  font-size: 27rpx;
  font-weight: 700;
}

.detour-value {
  color: #ff7043;
}

.stat-label {
  margin-top: 5rpx;
  color: #9a918b;
  font-size: 20rpx;
}

.segment-list {
  margin: 14rpx 0;
}

.segment-item {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.segment-line {
  width: 40rpx;
  height: 8rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 999rpx;
}

.first-line {
  background: #ff7043;
}

.second-line {
  background: #3478f6;
}

.segment-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.segment-title {
  color: #4c433d;
  font-size: 24rpx;
  font-weight: 600;
}

.segment-summary {
  overflow: hidden;
  margin-top: 3rpx;
  color: #938a84;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrival-button {
  width: 100%;
  height: 76rpx;
  margin: 8rpx 0 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  background: #ff7043;
}

.arrival-button::after,
.retry-button::after {
  border: none;
}

.state-box {
  display: flex;
  min-height: 260rpx;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  flex-direction: column;
}

.loading-circle {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 20rpx;
  border: 7rpx solid #f4d7ca;
  border-top-color: #ff7043;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}

@keyframes loading-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.error-title {
  color: #d34f35;
  font-size: 29rpx;
  font-weight: 700;
}

.error-message {
  margin-top: 10rpx;
  color: #847b75;
  font-size: 24rpx;
  text-align: center;
}

.retry-button {
  width: 220rpx;
  height: 70rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 70rpx;
  background: #ff7043;
}
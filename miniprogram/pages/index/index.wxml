<view class="page">
  <view class="hero">
    <text class="hero-title">今天顺路吃什么？</text>
    <text class="hero-subtitle">输入通勤路线，找一家最多绕路10分钟的餐厅</text>
  </view>

  <view class="card">
    <text class="section-title">今天从哪里出发？</text>

    <view class="location-row">
      <view class="location-dot start-dot"></view>
      <input
        class="location-input"
        placeholder="请输入起点，例如：公司"
        value="{{start}}"
        bindinput="onStartInput"
      />
      <view class="map-button" catch:tap="chooseStartLocation">地图选择</view>
    </view>

    <view class="route-line"></view>

    <view class="location-row">
      <view class="location-dot end-dot"></view>
      <input
        class="location-input"
        placeholder="请输入终点，例如：家"
        value="{{destination}}"
        bindinput="onDestinationInput"
      />
      <view class="map-button" catch:tap="chooseDestinationLocation">地图选择</view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">选择出行方式</text>

    <view class="travel-options">
      <view
        class="travel-item {{travelMode === '公交' ? 'active' : ''}}"
        data-mode="公交"
        bindtap="selectTravelMode"
      >
        公交
      </view>

      <view
        class="travel-item {{travelMode === '骑行' ? 'active' : ''}}"
        data-mode="骑行"
        bindtap="selectTravelMode"
      >
        骑行
      </view>

      <view
        class="travel-item {{travelMode === '步行' ? 'active' : ''}}"
        data-mode="步行"
        bindtap="selectTravelMode"
      >
        步行
      </view>
    </view>
    <button
      class="route-selection-button"
      bindtap="openRouteSelection"
    >
      查看可选路线
    </button>
  </view>

  <view class="card">
    <text class="section-title">今天想吃什么？</text>

    <textarea
      class="intent-input"
      placeholder="例如：想吃家常菜，辣一点，50元以内"
      maxlength="100"
      value="{{intentText}}"
      bindinput="onIntentInput"
    ></textarea>
  </view>

  <button
  class="search-button"
  bindtap="searchRestaurants"
  loading="{{isLoading}}"
  disabled="{{isLoading}}"
  > 
    {{isLoading ? "正在抽签..." : "抽签"}}
  </button>

  <text class="footer-tip">
    第一版使用模拟路线和餐厅数据
  </text>
</view>

<view
  wx:if="{{isDirectRouteLoading}}"
  class="direct-route-card"
>
  正在计算真实路线……
</view>

<view
  wx:elif="{{directRoute}}"
  class="direct-route-card"
>
  <view class="direct-route-header">
    <text class="direct-route-title">基础路线</text>
    <text class="real-route-badge">真实路线</text>
  </view>

  <text class="direct-route-points">
    {{start}} → {{destination}}
  </text>

  <view class="direct-route-stats">
    <view class="direct-route-stat">
      <text class="stat-label">出行方式</text>
      <text class="stat-value">{{directRoute.travel_mode}}</text>
    </view>

    <view class="direct-route-stat">
      <text class="stat-label">预计距离</text>
      <text class="stat-value">{{directRoute.distance_text}}</text>
    </view>

    <view class="direct-route-stat">
      <text class="stat-label">预计时间</text>
      <text class="stat-value">{{directRoute.duration_text}}</text>
    </view>
  </view>
</view>
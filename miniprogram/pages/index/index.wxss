page {
  background: #fffaf5;
  color: #2d251f;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.hero {
  padding: 30rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #2d251f;
}

.hero-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #8a7769;
}

.card {
  margin-bottom: 28rpx;
  padding: 34rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(91, 61, 40, 0.08);
}

.section-title {
  display: block;
  margin-bottom: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.location-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.location-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.start-dot {
  background: #32b768;
}

.end-dot {
  background: #ff7043;
}

.location-input {
  width: 100%;
  font-size: 29rpx;
}

.route-line {
  width: 4rpx;
  height: 28rpx;
  margin-left: 8rpx;
  background: #ded8d2;
}

.travel-options {
  display: flex;
  justify-content: space-between;
}

.travel-item {
  width: 30%;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6f6259;
  background: #f7f3ef;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.travel-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #ff7a45;
}

.intent-input {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f8f5f2;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.search-button {
  height: 96rpx;
  line-height: 96rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  background: #ff7a45;
  border-radius: 48rpx;
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 69, 0.25);
}

.search-button::after {
  border: none;
}

.footer-tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #aa9b90;
}
.results-section {
  margin-top: 36rpx;
}

.result-heading {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.result-title {
  margin-bottom: 8rpx;
}

.candidate-count {
  display: block;
  font-size: 25rpx;
  color: #99897d;
}

.restaurant-card {
  margin-bottom: 28rpx;
  padding: 34rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(91, 61, 40, 0.08);
}

.restaurant-top {
  display: flex;
  align-items: center;
}

.restaurant-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 22rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  background: #ff7a45;
  border-radius: 50%;
  flex-shrink: 0;
}

.restaurant-main {
  flex: 1;
}

.restaurant-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2d251f;
}

.restaurant-address {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #9a8b80;
}

.restaurant-info {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #65584f;
  border-top: 1rpx solid #f0ebe7;
  border-bottom: 1rpx solid #f0ebe7;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.tag {
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  padding: 8rpx 18rpx;
  color: #d85e2d;
  font-size: 24rpx;
  background: #fff0e8;
  border-radius: 20rpx;
}

.reason-box {
  margin-top: 12rpx;
  padding: 22rpx;
  background: #fffaf5;
  border-radius: 18rpx;
}

.reason-label {
  display: block;
  margin-bottom: 10rpx;
  color: #ff7043;
  font-size: 25rpx;
  font-weight: 600;
}

.reason-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6f6259;
}

.choose-button {
  margin-top: 24rpx;
  color: #ff7043;
  font-size: 28rpx;
  font-weight: 600;
  background: #ffffff;
  border: 2rpx solid #ff7043;
  border-radius: 42rpx;
}

.choose-button::after {
  border: none;
}


.redraw-button {
  margin-top: 8rpx;
  color: #7a6b61;
  font-size: 28rpx;
  background: transparent;
  border: 2rpx solid #d8cec7;
  border-radius: 44rpx;
}

.redraw-button::after {
  border: none;
}


.map-button {
  flex-shrink: 0;
  min-width: 126rpx;
  margin: 0 0 0 14rpx;
  padding: 0 18rpx;
  color: #ff7043;
  font-size: 24rpx;
  line-height: 62rpx;
  background: #fff0e9;
  border-radius: 999rpx;
}

.map-button {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  min-width: 126rpx;
  margin-left: 14rpx;
  padding: 0 18rpx;
  color: #ff7043;
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: center;
  background: #fff0e9;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.location-input {
  min-width: 0;
  flex: 1;
}

.direct-route-card {
  margin: 24rpx 28rpx;
  padding: 30rpx;
  color: #ffffff;
  background: #302824;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.direct-route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.direct-route-title {
  font-size: 34rpx;
  font-weight: 700;
}

.real-route-badge {
  padding: 8rpx 16rpx;
  color: #31b36b;
  font-size: 22rpx;
  background: rgba(49, 179, 107, 0.16);
  border-radius: 999rpx;
}

.direct-route-points {
  display: block;
  margin-top: 22rpx;
  color: #ded5d0;
  font-size: 27rpx;
  line-height: 1.5;
}

.direct-route-stats {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.direct-route-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.stat-label {
  color: #a99e98;
  font-size: 22rpx;
}

.stat-value {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}